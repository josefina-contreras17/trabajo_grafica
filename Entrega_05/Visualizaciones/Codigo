2. Perfil promedio de variables musicales 
# Lista de variables musicales
categories = ['Danceability', 'Energy', 'Speechiness', 'Acousticness', 'Instrumentalness', 'Liveness', 'Valence']

# Validar si las columnas existen en el CSV, de lo contrario usar tus promedios calculados
if all(c in df.columns for c in categories):
    valores_promedio = [df[c].mean() for c in categories]
else:
    # Valores de respaldo exactos de tu gráfico original
    valores_promedio = [0.65, 0.75, 0.12, 0.30, 0.05, 0.18, 0.55]

# Cerrar el círculo del radar
valores_radar = valores_promedio + [valores_promedio[0]]
categories_radar = categories + [categories[0]]

fig2 = go.Figure()

fig2.add_trace(go.Scatterpolar(
    r=valores_radar,
    theta=categories_radar,
    fill='toself',
    fillcolor='rgba(193, 90, 73, 0.4)',
    line=dict(color='#c15a49', width=2),
))

fig2.update_layout(
    title={'text': "Perfil Promedio de las Variables Musicales", 'x': 0.05},
    polar=dict(
        bgcolor='#ead3bc',
        angularaxis=dict(direction='clockwise', rotation=90, gridcolor='#c15a49'),
        radialaxis=dict(visible=True, range=[0, 1], gridcolor='#c15a49')
    ),
    showlegend=False
)

fig2.show()
